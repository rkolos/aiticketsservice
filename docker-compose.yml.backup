version: '3.8'

services:
  # PostgreSQL для Dify
  postgres:
    image: postgres:15-alpine
    container_name: ticket-ai-postgres
    environment:
      POSTGRES_DB: dify
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: difyai123456
    volumes:
      - './docker/postgres_data:/var/lib/postgresql/data'
    healthcheck:
      test: ['CMD-SHELL', 'pg_isready -U postgres']
      interval: 10s
      timeout: 5s
      retries: 5

  redis:
    image: redis:alpine
    container_name: ticket-ai-redis
    ports:
      - '6379:6379'
    volumes:
      - './docker/redis_data:/data'
    healthcheck:
      test: ['CMD', 'redis-cli', 'ping']
      interval: 10s
      timeout: 5s
      retries: 3

  # Dify API Server
  dify-api:
    image: langgenius/dify-api:latest
    container_name: ticket-ai-dify-api
    ports:
      - '5001:5001'
    environment:
      - MODE=api
      - LOG_LEVEL=INFO
      - SECRET_KEY=sk-9f73s3lj3ksdf9823kjsdf9823kjsdf9823kjsdf9823
      # Database configuration
      - DB_TYPE=postgresql
      - DB_USERNAME=postgres
      - DB_PASSWORD=difyai123456
      - DB_HOST=postgres
      - DB_PORT=5432
      - DB_DATABASE=dify
      - DATABASE_URL=postgresql://postgres:difyai123456@postgres:5432/dify
      - SQLALCHEMY_POOL_PRE_PING=true
      - SQLALCHEMY_POOL_TIMEOUT=30
      # Redis configuration
      - REDIS_HOST=redis
      - REDIS_PORT=6379
      - REDIS_PASSWORD=
      - REDIS_DB=0
      - CELERY_BROKER_URL=redis://redis:6379/1
      # API URLs
      - CONSOLE_API_URL=http://localhost:5001
      - CONSOLE_WEB_URL=http://localhost:3000
      - SERVICE_API_URL=http://localhost:5001
      - APP_WEB_URL=http://localhost:3000
      - FILES_URL=http://localhost:5001
      - INTERNAL_FILES_URL=http://dify-api:5001
      - TRIGGER_URL=http://localhost:5001
      - WEB_API_CORS_ALLOW_ORIGINS=*
      # Plugin Daemon configuration
      - PLUGIN_DAEMON_BASE_URL=http://dify-plugin-daemon:5002
      - PLUGIN_DAEMON_URL=http://dify-plugin-daemon:5002
      - PLUGIN_DAEMON_KEY=lYkiYYT6owG+71oLerGzA7GXCgOT++6ovaezWAjpCjf+Sjc3ZtU+qUEi
      - INNER_API_KEY_FOR_PLUGIN=QaHbTe77CtuXmsfyhR7+vRjI/+XbV1AaFy691iy+kGDv2Jvy0/eAh8Y1
      # Migration (required for first install)
      - MIGRATION_ENABLED=true
      # Storage configuration
      - STORAGE_TYPE=opendal
      - OPENDAL_SCHEME=fs
      - OPENDAL_FS_ROOT=storage
      # Locale
      - LANG=en_US.UTF-8
      - LC_ALL=en_US.UTF-8
      - PYTHONIOENCODING=utf-8
    volumes:
      - './docker/dify_storage:/app/api/storage'
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    healthcheck:
      test: ['CMD', 'curl', '-f', 'http://localhost:5001/health']
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 120s

  # Dify Plugin Daemon
  dify-plugin-daemon:
    image: langgenius/dify-plugin-daemon:0.4.1-local
    container_name: ticket-ai-dify-plugin-daemon
    ports:
      - '5002:5002'
      - '5003:5003'
    environment:
      - SERVER_PORT=5002
      - SERVER_KEY=lYkiYYT6owG+71oLerGzA7GXCgOT++6ovaezWAjpCjf+Sjc3ZtU+qUEi
      - PLUGIN_REMOTE_INSTALLING_HOST=0.0.0.0
      - PLUGIN_REMOTE_INSTALLING_PORT=5003
      - PLUGIN_DEBUGGING_HOST=0.0.0.0
      - PLUGIN_DEBUGGING_PORT=5003
      - DIFY_INNER_API_URL=http://dify-api:5001
      - DIFY_INNER_API_KEY=QaHbTe77CtuXmsfyhR7+vRjI/+XbV1AaFy691iy+kGDv2Jvy0/eAh8Y1
      # Database configuration
      - DB_TYPE=postgresql
      - DB_USERNAME=postgres
      - DB_PASSWORD=difyai123456
      - DB_HOST=postgres
      - DB_PORT=5432
      - DB_DATABASE=dify_plugin
      - DATABASE_URL=postgresql://postgres:difyai123456@postgres:5432/dify_plugin
      # Redis configuration
      - REDIS_HOST=redis
      - REDIS_PORT=6379
      - REDIS_PASSWORD=
      - STORAGE_TYPE=opendal
      - OPENDAL_SCHEME=fs
      - OPENDAL_FS_ROOT=storage
      - PLUGIN_STORAGE_TYPE=local
      - PLUGIN_STORAGE_LOCAL_ROOT=/app/storage
      - PLUGIN_WORKING_PATH=/app/storage/cwd
      - PLUGIN_INSTALLED_PATH=plugin
      - PLUGIN_PACKAGE_CACHE_PATH=plugin_packages
      - PLUGIN_MEDIA_CACHE_PATH=assets
      - PLUGIN_PYTHON_ENV_INIT_TIMEOUT=120
      - PLUGIN_MAX_EXECUTION_TIMEOUT=600
      - LANG=en_US.UTF-8
      - LC_ALL=en_US.UTF-8
    volumes:
      - './docker/dify_storage:/app/storage'
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
      dify-api:
        condition: service_healthy
    healthcheck:
      test: ['CMD', 'curl', '-f', 'http://localhost:5002/health']
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s

  # Dify Web Server
  dify-web:
    image: langgenius/dify-web:latest
    container_name: ticket-ai-dify-web
    ports:
      - '3000:3000'
    environment:
      - CONSOLE_API_URL=http://localhost:5001
      - APP_API_URL=http://localhost:5001
      - APP_WEB_URL=http://localhost:3000
      - NEXT_PUBLIC_API_PREFIX=http://localhost:5001/api
      - NEXT_PUBLIC_PUBLIC_API_PREFIX=http://localhost:5001/api
      - NEXT_PUBLIC_EDITION=SELF_HOSTED
      - NEXT_PUBLIC_DEPLOY_ENV=DEVELOPMENT
    depends_on:
      dify-api:
        condition: service_healthy
    healthcheck:
      test: ['CMD', 'curl', '-f', 'http://localhost:3000']
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s

  worker:
    build:
      context: .
      dockerfile: Dockerfile
      target: development
    container_name: ticket-ai-worker
    volumes:
      - './src:/app/src'
      - '/app/node_modules'
    environment:
      - REDIS_HOST=redis
      - DIFY_API_URL=http://dify-api:5001
    depends_on:
      redis:
        condition: service_healthy
      dify-api:
        condition: service_healthy
    healthcheck:
      test: ['CMD', 'wget', '--quiet', '--tries=1', '--spider', 'http://localhost:${HEALTHCHECK_PORT:-3000}/health']
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

