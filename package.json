{
  "name": "ticket-ai-worker",
  "version": "1.0.0",
  "description": "AI worker service for processing tickets via Dify (BullMQ/Redis)",
  "main": "src/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "start:with-dify-check": "node scripts/start-with-dify-check.js --check-dify",
    "dev:with-dify-check": "node scripts/start-with-dify-check.js --check-dify --dev",
    "start:skip-dify": "node scripts/start-with-dify-check.js --skip-dify-check",
    "dev:skip-dify": "node scripts/start-with-dify-check.js --skip-dify-check --dev",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write src/**/*.js",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:build": "docker-compose build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:smoke": "node scripts/smoke-test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@jest/test-sequencer": "^30.2.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.2.0",
    "nock": "^14.0.10",
    "nodemon": "^3.1.11",
    "prettier": "^3.7.4",
    "uuid": "^13.0.0"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "bullmq": "^5.65.1",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "form-data": "^4.0.5",
    "ioredis": "^5.8.2",
    "joi": "^18.0.2",
    "tiktoken": "^1.0.22",
    "winston": "^3.19.0"
  }
}
